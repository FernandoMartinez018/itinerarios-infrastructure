# Copiar como .env y reemplazar por valores reales. Nunca commitear .env real.

AIRPORT_DB_USER=airport_user
AIRPORT_DB_PASSWORD=changeme

ITINERARY_DB_USER=itinerary_user
ITINERARY_DB_PASSWORD=changeme

NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASSWORD=changeme

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

FRONTEND_URL=http://localhost:4200
RATE_LIMIT_RPS=20

COLOMBIA_API_BASE_URL=https://api-colombia.com/api/v1

GRAFANA_ADMIN_PASSWORD=changeme

# LocalStack (perfil "serverless"). Región ficticia local; sin credenciales reales.
AWS_REGION=us-east-1
# Opcional: solo si se usa una imagen de LocalStack que exija token.
LOCALSTACK_AUTH_TOKEN=

# Keycloak / OAuth2 Client Credentials (paso 31). Opcionales en local: Compose trae valores de
# desarrollo por defecto. En AWS se usan SSM SecureString (nunca estos valores).
KEYCLOAK_ADMIN_PASSWORD=changeme
GATEWAY_CLIENT_SECRET=changeme-gateway
ITINERARY_CLIENT_SECRET=changeme-itinerary
# Usuario de prueba de Keycloak (contrasena temporal: se cambia en el primer login).
TEST_USER_EMAIL=tester@example.com
TEST_USER_PASSWORD=changeme-tester
